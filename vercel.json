{
  "version": 2,
  "builds": [
    { "src": "apps/web/package.json", "use": "@vercel/next" },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["services/api/app/**", "config/**", "fixtures/**"] }
    }
  ],
  "routes": [
    { "src": "/(v1/.*|health|docs|redoc|openapi\\.json)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/apps/web/$1" }
  ]
}
